# ==============================================================================
# Mini Payment System - Environment Configuration Template
# ==============================================================================

# Application Configuration
NODE_ENV=development
API_PORT=3000

# ------------------------------------------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payment_db
POSTGRES_PORT=5432

# Option 1: When running the API locally on your Mac host (outside Docker):
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_db

# Option 2: When running the API inside the Docker network (e.g., containerized):
# POSTGRES_HOST=postgres
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/payment_db

# ------------------------------------------------------------------------------
# Infrastructure Ports (for docker-compose services)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8085

